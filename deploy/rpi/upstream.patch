+++ b/frontend/src/lib/services/moonraker.ts
@@ -0,0 +1,155 @@
+import { ApiError, type components, type PrusaConnect } from '@prusa/connect';
+
+export type MoonrakerClient = Pick<
+  PrusaConnect,
+  'putConnectorEndpoint' | 'listConnectorEndpoints' | 'listDevices'
+>;
+export interface MoonrakerDraft {
+  readonly name: string;
+  readonly address: string;
+}
+
+const endpointName = (name: string): string =>
+  name.toLowerCase().replaceAll('_', '-');
+const endpointOptions = (name: string) => ({
+  serial: name,
+  unit_uid: endpointName(name),
+  model: 'Klipper',
+});
+
+export const moonrakerDraft = (
+  name: string,
+  address: string,
+): MoonrakerDraft | undefined => {
+  const id = name.trim();
+  if (!/^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$/u.test(id)) return undefined;
+  try {
+    const explicit = address.includes('://');
+    const url = new URL(explicit ? address.trim() : `http://${address.trim()}`);
+    if (
+      !['http:', 'https:'].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash ||
+      url.pathname !== '/'
+    )
+      return undefined;
+    const suppliedPort = /^(?:\[[^\]]+\]|[^:]+):[0-9]+$/u.test(
+      address.trim().replace(/\/$/u, ''),
+    );
+    if (!explicit && !suppliedPort && !url.port) url.port = '7125';
+    return { name: id, address: url.origin };
+  } catch {
+    return undefined;
+  }
+};
+
+type Endpoint = components['schemas']['ConnectorEndpoint'];
+
+const matches = (row: Endpoint, draft: MoonrakerDraft): boolean =>
+  row.name === endpointName(draft.name) &&
+  row.connector === 'pcma' &&
+  row.address === draft.address &&
+  row.enabled &&
+  row.options?.serial === draft.name &&
+  row.options.unit_uid === endpointName(draft.name) &&
+  row.options.model === 'Klipper' &&
+  Object.keys(row.options).length === 3;
+
+export const addMoonraker = async (
+  client: MoonrakerClient,
+  draft: MoonrakerDraft,
+  signal: AbortSignal,
+) => {
+  try {
+    return await client.putConnectorEndpoint(
+      {
+        path: { name: endpointName(draft.name) },
+        header: { 'If-None-Match': '*' },
+        body: {
+          connector: 'pcma',
+          address: draft.address,
+          enabled: true,
+          options: endpointOptions(draft.name),
+        },
+      },
+      signal,
+    );
+  } catch (error) {
+    if (error instanceof ApiError && error.status !== 412) throw error;
+    let existing: Endpoint | undefined;
+    try {
+      const rows = await client.listConnectorEndpoints({}, signal);
+      existing = rows.items?.find((row) => matches(row, draft));
+    } catch {
+      throw error;
+    }
+    if (existing) return existing;
+    throw error;
+  }
+};
+
+export const updateMoonraker = async (
+  client: MoonrakerClient,
+  previous: MoonrakerDraft,
+  next: MoonrakerDraft,
+  signal: AbortSignal,
+): Promise<void> => {
+  const rows = await client.listConnectorEndpoints({}, signal);
+  if (rows.items?.some((row) => matches(row, next))) return;
+  const current = rows.items?.find((row) => matches(row, previous));
+  if (!current || next.name !== previous.name)
+    throw new Error('The connection changed. Reload before editing it.');
+  await client.putConnectorEndpoint(
+    {
+      path: { name: endpointName(previous.name) },
+      header: { 'If-Match': `"${current.version}"` },
+      body: {
+        connector: current.connector,
+        address: next.address,
+        enabled: true,
+        options: endpointOptions(previous.name),
+      },
+    },
+    signal,
+  );
+};
+
+export const readMoonraker = async (
+  client: MoonrakerClient,
+  name: string,
+  signal: AbortSignal,
+): Promise<components['schemas']['Device'] | undefined> => {
+  let offset = 0;
+  while (!signal.aborted) {
+    const page = await client.listDevices(
+      { query: { search: name, limit: 100, offset } },
+      signal,
+    );
+    const rows = page.items ?? [];
+    const device = rows.find(
+      (row) =>
+        row.driver === 'pcma' &&
+        row.serial === name &&
+        row.unit_uid === endpointName(name),
+    );
+    if (device) return device;
+    offset += rows.length;
+    if (rows.length === 0 || offset >= page.total) return undefined;
+  }
+  return undefined;
+};
+
+export const connectedMoonraker = async (
+  client: MoonrakerClient,
+  name: string,
+  signal: AbortSignal,
+  afterEpoch?: number,
+): Promise<string | undefined> => {
+  const device = await readMoonraker(client, name, signal);
+  return device?.connected &&
+    (afterEpoch === undefined || device.capability_epoch > afterEpoch)
+    ? device.id
+    : undefined;
+};
