@@ -0,0 +1,154 @@
+import type { ApiError } from '@prusa/connect';
+
+import {
+  addMoonraker,
+  connectedMoonraker,
+  updateMoonraker,
+  readMoonraker,
+  type MoonrakerClient,
+  type MoonrakerDraft,
+} from '../services/moonraker';
+
+type Phase =
+  'idle' | 'saving' | 'connecting' | 'waiting' | 'connected' | 'error';
+
+const pause = (signal: AbortSignal): Promise<void> =>
+  new Promise((resolve) => {
+    const finish = () => {
+      clearTimeout(timer);
+      signal.removeEventListener('abort', finish);
+      resolve();
+    };
+    const timer = setTimeout(finish, 1000);
+    signal.addEventListener('abort', finish, { once: true });
+    if (signal.aborted) finish();
+  });
+
+export class MoonrakerSetup {
+  readonly #client: MoonrakerClient;
+  readonly #timeout: number;
+  #phase = $state<Phase>('idle');
+  #error = $state.raw<ApiError | Error>();
+  #saved = $state.raw<MoonrakerDraft>();
+  #deviceId = $state<string>();
+  #editing = $state(false);
+  #afterEpoch: number | undefined;
+  #flight: Promise<void> | undefined;
+  #controller: AbortController | undefined;
+  #closed = false;
+
+  constructor(client: MoonrakerClient, timeout = 20_000) {
+    this.#client = client;
+    this.#timeout = timeout;
+  }
+
+  get phase() {
+    return this.#phase;
+  }
+  get error() {
+    return this.#error;
+  }
+  get saved() {
+    return this.#saved !== undefined;
+  }
+  get draft() {
+    return this.#saved;
+  }
+  get deviceId() {
+    return this.#deviceId;
+  }
+  get editing() {
+    return this.#editing;
+  }
+
+  editAddress(): void {
+    if (!this.busy && this.#saved && !this.#deviceId && !this.#closed) {
+      this.#editing = true;
+      this.#afterEpoch = undefined;
+      this.#phase = 'idle';
+      this.#error = undefined;
+    }
+  }
+  get busy() {
+    return this.#phase === 'saving' || this.#phase === 'connecting';
+  }
+
+  connect(draft: MoonrakerDraft): Promise<void> {
+    if (this.#closed) return Promise.resolve();
+    this.#flight ??= this.#connect(
+      this.#editing ? draft : (this.#saved ?? draft),
+    ).finally(() => {
+      this.#flight = undefined;
+    });
+    return this.#flight;
+  }
+
+  close(): void {
+    this.#closed = true;
+    this.#controller?.abort();
+  }
+
+  #cancelled(signal: AbortSignal): boolean {
+    return this.#closed || signal.aborted;
+  }
+
+  async #connect(draft: MoonrakerDraft): Promise<void> {
+    const controller = new AbortController();
+    this.#controller = controller;
+    const timer = setTimeout(() => {
+      controller.abort();
+    }, this.#timeout);
+    this.#error = undefined;
+    this.#phase = this.#saved && !this.#editing ? 'connecting' : 'saving';
+    try {
+      if (this.#editing && this.#saved) {
+        if (draft.address !== this.#saved.address) {
+          this.#afterEpoch ??=
+            (await readMoonraker(this.#client, draft.name, controller.signal))
+              ?.capability_epoch ?? 0;
+          await updateMoonraker(
+            this.#client,
+            this.#saved,
+            draft,
+            controller.signal,
+          );
+        }
+        if (this.#closed) return;
+        this.#saved = draft;
+        this.#editing = false;
+      } else if (!this.#saved) {
+        await addMoonraker(this.#client, draft, controller.signal);
+        if (this.#closed) return;
+        this.#saved = draft;
+      }
+      this.#phase = 'connecting';
+      while (!controller.signal.aborted) {
+        const id = await connectedMoonraker(
+          this.#client,
+          draft.name,
+          controller.signal,
+          this.#afterEpoch,
+        );
+        if (this.#cancelled(controller.signal)) break;
+        if (id) {
+          this.#deviceId = id;
+          this.#phase = 'connected';
+          return;
+        }
+        await pause(controller.signal);
+      }
+      if (!this.#closed) this.#phase = 'waiting';
+    } catch (error) {
+      if (this.#closed) return;
+      if (controller.signal.aborted && this.#saved) this.#phase = 'waiting';
+      else {
+        this.#error =
+          error instanceof Error ? error : new Error('Moonraker setup failed');
+        this.#phase = 'error';
+      }
+    } finally {
+      clearTimeout(timer);
+      this.#controller = undefined;
+    }
+  }
+}
