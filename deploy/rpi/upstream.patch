+    .fill('printer.local:7125');
+};
+
+describe('Moonraker setup form', () => {
+  it('opens the printer only after the device is connected', async () => {
+    const stub = stubClient({
+      'PUT /api/v1/connector-endpoints/lab': json(201, {}),
+      'GET /api/v1/devices': json(200, {
+        total: 1,
+        items: [
+          {
+            id: 'device-1',
+            serial: 'lab',
+            unit_uid: 'lab',
+            driver: 'pcma',
+            connected: true,
+          },
+        ],
+      }),
+    });
+    await render(Setup, { setup: new MoonrakerSetup(stub.client) });
+    await fill();
+    await page
+      .getByRole('button', { name: 'Connect printer', exact: true })
+      .click();
+    await expect
+      .element(page.getByRole('link', { name: 'Open printer' }))
+      .toHaveAttribute('href', '/printers/device-1');
+    await expect
+      .element(page.getByText('Printer connected.', { exact: true }))
+      .toBeVisible();
+  });
+
+  it('keeps duplicate-name refusal visible without overwriting a connection', async () => {
+    const stub = stubClient({
+      'PUT /api/v1/connector-endpoints/lab': problem(
+        412,
+        'RESOURCE_VERSION_CONFLICT',
+      ),
+    });
+    await render(Setup, { setup: new MoonrakerSetup(stub.client) });
+    await fill();
+    await page
+      .getByRole('button', { name: 'Connect printer', exact: true })
+      .click();
+    await expect
+      .element(page.getByText('RESOURCE_VERSION_CONFLICT', { exact: true }))
+      .toBeVisible();
+    expect(stub.count('PUT /api/v1/connector-endpoints/lab')).toBe(1);
+    await expect
+      .element(page.getByRole('textbox', { name: 'Printer name' }))
+      .toBeEnabled();
+  });
+});
