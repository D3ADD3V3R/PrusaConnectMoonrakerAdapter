+import { MoonrakerSetup } from './moonraker-setup.svelte';
+
+const draft = { name: 'lab', address: 'http://printer.local:7125' };
+const endpoint = 'PUT /api/v1/connector-endpoints/lab';
+const devices = 'GET /api/v1/devices';
+
+describe('Moonraker setup', () => {
+  it('allows correction of a saved offline address and waits for a new session', async () => {
+    let updated = false;
+    const stub = stubClient({
+      [endpoint]: (call) => {
+        if (call.ifMatch) updated = true;
+        return json(200, {});
+      },
+      'GET /api/v1/connector-endpoints': json(200, {
+        items: [
+          {
+            ...draft,
+            connector: 'pcma',
+            enabled: true,
+            options: { model: 'Klipper', serial: 'lab', unit_uid: 'lab' },
+            version: 'v1',
+          },
+        ],
+      }),
+      [devices]: () =>
+        json(200, {
+          total: 1,
+          items: [
+            {
+              id: 'printer',
+              driver: 'pcma',
+              serial: 'lab',
+              unit_uid: 'lab',
+              connected: updated,
+              capability_epoch: updated ? 2 : 1,
+            },
+          ],
+        }),
+    });
+    const setup = new MoonrakerSetup(stub.client, 40);
+    await setup.connect(draft);
+    expect(setup.phase).toBe('waiting');
+    setup.editAddress();
+    expect(setup.editing).toBe(true);
+    await setup.connect({ ...draft, address: 'http://correct:7125' });
+    expect(setup.draft?.address).toBe('http://correct:7125');
+    expect(setup.phase).toBe('connected');
+    expect(stub.calls.find((call) => call.ifMatch)?.ifMatch).toBe('"v1"');
+    setup.close();
+  });
+  it('waits for a matching live printer and submits once for concurrent clicks', async () => {
+    const stub = stubClient({
+      [endpoint]: json(201, {}),
+      [devices]: json(200, {
+        total: 1,
+        items: [
+          {
+            id: 'connected',
+            serial: 'lab',
+            unit_uid: 'lab',
+            driver: 'pcma',
+            connected: true,
+          },
+        ],
+      }),
+    });
+    const setup = new MoonrakerSetup(stub.client);
+    expect(setup.phase).toBe('idle');
+    const first = setup.connect(draft);
+    expect(setup.busy).toBe(true);
+    expect(setup.connect(draft)).toBe(first);
+    await first;
+    expect(setup.phase).toBe('connected');
+    expect(setup.deviceId).toBe('connected');
+    expect(stub.count(endpoint)).toBe(1);
+    expect(JSON.parse(stub.calls[0]?.body ?? '{}')).toMatchObject({
+      connector: 'pcma',
+      address: draft.address,
+      enabled: true,
+    });
+    setup.close();
+  });
+
+  it('keeps a saved unreachable printer and retries without creating another endpoint', async () => {
+    const stub = stubClient({
+      [endpoint]: json(201, {}),
+      [devices]: json(200, {
+        total: 1,
+        items: [
+          {
+            id: 'offline',
+            serial: 'lab',
+            unit_uid: 'lab',
+            driver: 'pcma',
+            connected: false,
+          },
+        ],
+      }),
+    });
+    const setup = new MoonrakerSetup(stub.client, 30);
+    await setup.connect(draft);
+    expect(setup.saved).toBe(true);
+    expect(setup.phase).toBe('waiting');
+    expect(setup.deviceId).toBeUndefined();
+    await setup.connect(draft);
+    expect(stub.count(endpoint)).toBe(1);
+    setup.close();
+  });
+
+  it('reports refusal without claiming the endpoint was saved', async () => {
+    const stub = stubClient({ [endpoint]: problem(403, 'AUTHZ_FORBIDDEN') });
+    const setup = new MoonrakerSetup(stub.client);
+    await setup.connect(draft);
+    expect(setup.phase).toBe('error');
+    expect(setup.saved).toBe(false);
+    expect(setup.error).toBeDefined();
+    expect(stub.count(devices)).toBe(0);
+    setup.close();
+  });
+
+  it('stops polling on disposal and ignores a response arriving afterwards', async () => {
+    let release = () => undefined;
+    const response = new Promise<Response>((resolve) => {
+      release = () => {
+        resolve(json(201, {}));
+      };
+    });
+    const stub = stubClient({ [endpoint]: () => response });
+    const setup = new MoonrakerSetup(stub.client);
+    const flight = setup.connect(draft);
+    setup.close();
+    release();
+    await flight;
+    expect(setup.saved).toBe(false);
+    expect(stub.count(devices)).toBe(0);
+    await setup.connect(draft);
+    expect(stub.count(endpoint)).toBe(1);
+  });
+});
