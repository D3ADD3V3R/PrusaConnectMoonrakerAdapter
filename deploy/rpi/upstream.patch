+<script lang="ts">
+  import {
+    describeFault,
+    t as coreT,
+    translateFor,
+  } from '@prusa/connect-ui/i18n';
+  import {
+    Alert,
+    AlertDescription,
+    Button,
+    Card,
+    CardContent,
+    CardHeader,
+    CardTitle,
+    FaultAlert,
+    Field,
+    Input,
+    PageHeader,
+    PageTrail,
+  } from '@prusa/connect-ui/primitives';
+  import { printerHref } from '@prusa/connect-ui/shell';
+  import { onDestroy } from 'svelte';
+
+  import { client } from '../../client';
+  import { moonrakerDraft } from '../../services/moonraker';
+  import { MoonrakerSetup } from '../../stores/moonraker-setup.svelte';
+
+  interface Props {
+    setup?: MoonrakerSetup;
+  }
+  let { setup = new MoonrakerSetup(client) }: Props = $props();
+  let name = $state('');
+  let address = $state('');
+  let invalid = $state(false);
+  const t = translateFor('app');
+  const fault = $derived(setup.error ? describeFault(setup.error) : undefined);
+  const locked = $derived(setup.busy || setup.saved);
+  const deviceHref = $derived(
+    setup.deviceId ? printerHref(setup.deviceId) : undefined,
+  );
+  const submitLabel = $derived.by(() => {
+    if (setup.editing) return 'app.addPrinter.moonraker.update';
+    if (setup.saved) return 'app.addPrinter.moonraker.retry';
+    return 'app.addPrinter.moonraker.connect';
+  });
+  onDestroy(() => {
+    setup.close();
+  });
+
+  const submit = (event: SubmitEvent) => {
+    event.preventDefault();
+    const draft = setup.editing
+      ? moonrakerDraft(setup.draft?.name ?? name, address)
+      : (setup.draft ?? moonrakerDraft(name, address));
+    invalid = !draft;
+    if (draft) void setup.connect(draft);
+  };
+</script>
+
+<section class="flex flex-col gap-4">
+  <PageTrail
+    trail={[{ label: coreT('addPrinter.trail.printers'), href: '/printers' }]}
+    page={coreT('addPrinter.title')}
+  />
+  <PageHeader title={coreT('addPrinter.title')} />
+  <Card>
+    <CardHeader
+      ><CardTitle>{t('app.addPrinter.moonraker.title')}</CardTitle></CardHeader
+    >
+    <CardContent>
+      <form class="flex flex-col gap-4" onsubmit={submit}>
+        <p class="text-sm text-muted-foreground">
+          {t('app.addPrinter.moonraker.description')}
+        </p>
+        <Field
+          label={t('app.addPrinter.moonraker.name')}
+          description={t('app.addPrinter.moonraker.nameHint')}
+          control={Input}
+          controlProps={{
+            value: setup.draft?.name ?? name,
+            required: true,
+            maxlength: 63,
+            disabled: locked,
+            oninput: (event: Event) => {
+              if (event.currentTarget instanceof HTMLInputElement)
+                name = event.currentTarget.value;
+            },
+          }}
+        />
+        <Field
+          label={t('app.addPrinter.moonraker.address')}
+          description={t('app.addPrinter.moonraker.addressHint')}
+          control={Input}
+          controlProps={{
+            value: setup.editing ? address : (setup.draft?.address ?? address),
+            required: true,
+            maxlength: 253,
+            disabled: setup.busy || (setup.saved && !setup.editing),
+            oninput: (event: Event) => {
+              if (event.currentTarget instanceof HTMLInputElement)
+                address = event.currentTarget.value;
+            },
+          }}
+        />
+        {#if invalid}<Alert variant="destructive"
+            ><AlertDescription
+              >{t('app.addPrinter.moonraker.invalid')}</AlertDescription
+            ></Alert
+          >{/if}
+        {#if fault}<FaultAlert {fault} />{/if}
+        <div aria-live="polite">
+          {#if setup.busy}<p>{t('app.addPrinter.moonraker.connecting')}</p>
+          {:else if setup.phase === 'waiting'}<Alert variant="warning"
+              ><AlertDescription
+                >{t('app.addPrinter.moonraker.waiting')}</AlertDescription
+              ></Alert
+            >
+          {:else if setup.phase === 'connected'}<Alert variant="success"
+              ><AlertDescription
+                >{t('app.addPrinter.moonraker.connected')}</AlertDescription
+              ></Alert
+            >{/if}
+        </div>
+        <div class="flex flex-wrap gap-2">
+          {#if deviceHref}
+            <Button
+              >{#snippet child({ props })}<a {...props} href={deviceHref}
+                  >{t('app.addPrinter.moonraker.open')}</a
+                >{/snippet}</Button
+            >
+          {:else}
+            <Button type="submit" pending={setup.busy}>{t(submitLabel)}</Button>
+          {/if}
+          {#if setup.saved && !setup.busy && !setup.editing && !deviceHref}
+            <Button
+              type="button"
+              variant="secondary"
+              onclick={() => {
+                address = setup.draft?.address ?? '';
+                setup.editAddress();
+              }}>{t('app.addPrinter.moonraker.edit')}</Button
+            >
+          {/if}
+          <Button variant="secondary"
+            >{#snippet child({ props })}<a {...props} href="/printers"
+                >{t('app.addPrinter.moonraker.back')}</a
+              >{/snippet}</Button
+          >
+        </div>
+      </form>
+    </CardContent>
+  </Card>
+</section>
+<p class="text-xs text-muted-foreground">{t('app.addPrinter.attribution')}</p>
